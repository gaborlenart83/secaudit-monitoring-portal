// SecAudit – Prisma séma (MySQL 8.0)
// Forrás: rendszerterv.md 2. fejezet (ER-diagram) + 5. fejezet (onDelete: Cascade előírás)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Grade {
  A
  B
  C
  D
  F
}

enum Severity {
  WARNING
  CRITICAL
}

model User {
  id        Int             @id @default(autoincrement())
  email     String          @unique @db.VarChar(255)
  password  String          @db.VarChar(255)
  name      String          @db.VarChar(255)
  role      Role            @default(USER)
  createdAt DateTime        @default(now())
  sites     MonitoredSite[]
}

model MonitoredSite {
  id        Int            @id @default(autoincrement())
  userId    Int
  name      String         @db.VarChar(255)
  url       String         @db.VarChar(2048)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans     SecurityScan[]
  incidents IncidentLog[]

  @@index([userId])
}

model SecurityScan {
  id             Int           @id @default(autoincrement())
  siteId         Int
  statusCode     Int
  responseTimeMs Int
  hasHttps       Boolean
  hasHsts        Boolean
  hasCsp         Boolean
  hasXFrame      Boolean
  score          Int
  grade          Grade
  scannedAt      DateTime      @default(now())
  site           MonitoredSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // legutóbbi scan és előzmények lekérdezése (GET /api/sites, /history)
  @@index([siteId, scannedAt])
}

model IncidentLog {
  id         Int           @id @default(autoincrement())
  siteId     Int
  severity   Severity
  message    String        @db.VarChar(1000)
  isResolved Boolean       @default(false)
  createdAt  DateTime      @default(now())
  site       MonitoredSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, isResolved])
}